# Copy to .env and adjust. Never commit .env.
APP_NAME=CivIQ API
ENV=dev
DATABASE_URL=postgresql+psycopg://civiq:civiq@localhost:5432/civiq
# Fallback when Postgres is unreachable: sqlite:///./data/civiq.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:3000
# S3-compatible storage (MinIO for local dev). If unset -> local disk ./data/files
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=civiq-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Copilot LLM (OpenAI-compatible). If unset -> local keyword responder.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Email (dev default logs tokens to console)
SMTP_URL=
MAIL_FROM=noreply@civiq.ai
